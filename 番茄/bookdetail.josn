      "cot_value_crc": "3707731368,707193152,2084506717,2930351447,788455192,3468102397,3419416178,1294815024,4287278490,37358168,3090151896,1287535775,1966659455,3849656389,2419478268,3464866031,1132331801,3269093998,4016940897,3028423420,1860295677,739587691,3035540771,1526761135,4021035347,681052040,1735209756,1606269350,233600505,1243299675,1274663102,3857972571,4252787321,1720524887,1920422898,2490714837,3505526022,3608558563,1555853789,4160690944,629247242,1075874325,1798076571,1341180826,233014032,2622341846",
